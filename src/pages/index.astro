---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import DagScene from '../components/DagScene.astro';
import AboutMap from '../components/AboutMap.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import { profile } from '../data/site';
---

<BaseLayout title="Rafael Targino — Data Engineer & Software Builder" description="Portfolio of Rafael Targino, data engineer and software builder based in São Paulo, Brazil.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
    <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="eyebrow hero-eyebrow"><span class="status-dot"></span> Available for interesting problems</p>
      <h1 id="hero-title">I build data systems that move <em>business</em> forward.</h1>
      <p class="hero-copy">I’m Rafael, a data engineer and software builder. I turn messy operations into reliable platforms, intelligent workflows, and measurable results.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/contact">Contact me <Icon name="arrow" size={18} /></a>
        <a class="button button-secondary" href="/experience">My experience</a>
      </div>
    </div>
    <div class="hero-aside" data-reveal>
      <div class="profile-image-wrap"><img src="/assets/img/profile.jpg" alt="Rafael Targino" width="400" height="500" /></div>
      <div class="availability-note"><span>Based in</span><strong>São Paulo, BR</strong><span class="note-line" aria-hidden="true"></span></div>
      <div class="hero-social-links" aria-label="Rafael’s social links">
        <a href={profile.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn"><Icon name="linkedin" size={18} /></a>
        <a href={profile.github} target="_blank" rel="noreferrer" aria-label="GitHub"><Icon name="github" size={18} /></a>
        <a href={`mailto:${profile.email}`} aria-label="Email"><Icon name="mail" size={18} /></a>
        <a href={profile.youtube} target="_blank" rel="noreferrer" aria-label="YouTube"><Icon name="youtube" size={19} /></a>
      </div>
    </div>
    <a class="scroll-cue" href="#about" aria-label="Scroll to about section"><span>Scroll to discover</span><i></i></a>
  </section>

  <section class="section about-section" id="about">
    <SectionHeading eyebrow="01 — About" title="A practical builder with an economist’s instinct." />
    <div class="about-content-layout">
      <AboutMap />
      <div class="about-content">
        <div class="about-grid">
          <div class="about-copy" id="about-story" data-reveal>
            <p class="large-copy">For the past <strong>8+ years</strong>, I’ve helped teams turn complex data, financial, and technology challenges into products people can depend on.</p>
            <p>I work comfortably between strategy and implementation: designing a data platform, shaping the developer experience, or getting a system across the finish line with the people who use it.</p>
            <a class="text-link" href={`mailto:${profile.email}`}>Let’s talk <Icon name="arrow" size={17} /></a>
          </div>
          <div class="impact-grid" id="about-impact" data-reveal style="--delay: 120ms">
            <div class="impact-card"><strong>83M</strong><span>people reached through data products</span></div>
            <div class="impact-card accent"><strong>$70M+</strong><span>value created for the businesses I’ve worked with</span></div>
          </div>
        </div>
        <TestimonialCarousel />
      </div>
    </div>
  </section>

  <section class="contact-banner" id="contact">
    <div class="contact-content-layout">
      <AboutMap />
      <div>
        <p class="eyebrow">A good next conversation</p>
        <h2>Have a complex problem worth solving?</h2>
        <DagScene />
        <a class="button button-light" href="/contact">Let’s talk? <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>
</BaseLayout>
