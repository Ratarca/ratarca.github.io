---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import LabGrid from '../components/LabGrid.astro';
---

<BaseLayout title="Labs — Rafael Targino" description="Selected experiments, data platforms, backend systems, and AI explorations by Rafael Targino." current="labs">
  <section class="labs-hero" aria-labelledby="labs-title">
    <p class="eyebrow"><Icon name="sparkle" size={15} /> Rafael’s labs</p>
    <h1 id="labs-title">Ideas become more interesting when they <em>ship.</em></h1>
    <p>A working collection of systems, explorations, and small bets across data, infrastructure, AI, and finance.</p>
    <a class="lab-cta-pill" href="/contact">
      <span class="lab-cta-pulse" aria-hidden="true"></span>
      <span class="lab-cta-copy">
        <strong>Every lab here started as someone’s messy problem.</strong>
        <span>Bring yours — I’ll help you turn it into the next one.</span>
      </span>
      <span class="lab-cta-arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>
    </a>
  </section>
  <section class="labs-section" aria-label="Lab projects">
    <LabGrid />
  </section>
  <section class="labs-cta">
    <p class="eyebrow">Open to collaboration</p>
    <h2>Want to build something useful together?</h2>
    <p class="labs-cta-copy">From data pipelines to agentic workflows — the labs above show how I work. Your project could be the next entry.</p>
    <a class="lab-cta-pill lab-cta-pill-dark" href="/contact">
      <span class="lab-cta-pulse" aria-hidden="true"></span>
      <span class="lab-cta-copy">
        <strong>Start your project’s lab notebook today.</strong>
        <span>Tell me the problem — I’ll bring the system.</span>
      </span>
      <span class="lab-cta-arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>
    </a>
  </section>
</BaseLayout>
