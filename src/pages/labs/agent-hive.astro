---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

const agents = [
  { code: '01', name: 'Coordinator', text: 'Owns the outcome, designs the gateway, decomposes the sprint, and routes each task without giving away accountability.' },
  { code: '02', name: 'Context compiler', text: 'Selects the contracts, dependencies, history, and evidence a worker needs—enough context to act, without flooding the prompt.' },
  { code: '03', name: 'Specialists', text: 'Backend, frontend, data, and infrastructure agents implement bounded work in parallel where their write scopes are truly independent.' },
  { code: '04', name: 'Independent QA', text: 'Replays acceptance from the consumer boundary, verifies the evidence, and sends failures back as explicit repair work.' }
];

const loop = [
  { title: 'Design the gateway', text: 'Freeze the product intent, dependencies, acceptance commands, ownership, and delivery destination before implementation begins.' },
  { title: 'Compile context', text: 'Build a focused task packet from the knowledge graph: relevant contracts, past failures, boundaries, tools, and expected evidence.' },
  { title: 'Run the sprint DAG', text: 'Dispatch ready tasks to specialists, allow safe parallelism, and keep blocked or dependent work visible in the same graph.' },
  { title: 'Validate independently', text: 'QA checks the actual consumer path and either approves the candidate or creates a bounded repair loop in the same workspace.' },
  { title: 'Integrate and learn', text: 'Merge the reviewed result, run final acceptance, archive the gateway, and carry evidence-based lessons into the next sprint.' }
];

const foundations = [
  { title: 'Gateway as control plane', text: 'A single durable gateway connects the brief, Kanban state, dependencies, acceptance, handoffs, and final receipt. It gives every agent the same operational truth.' },
  { title: 'DAG as execution model', text: 'The work graph decides what is ready, what can run in parallel, and what must wait. Coordination follows dependencies instead of relying on agents to improvise the order.' },
  { title: 'Evidence over narration', text: 'Tests, revision hashes, structured iteration records, and generated artifacts prove what happened. A confident summary never substitutes for a verified result.' }
];
---

<BaseLayout title="Agent Hive — Rafael Targino" description="How the Media Factory coordinates specialist AI agents through design gateways, sprint DAGs, durable context, independent QA, and verified delivery." current="labs">
  <section class="project-hero agent-hive-hero" aria-labelledby="project-title">
    <a class="project-back" href="/labs"><Icon name="arrow" size={16} /> Back to labs</a>
    <div class="project-hero-grid">
      <div>
        <p class="eyebrow">Lab 05 · Agentic systems</p>
        <h1 id="project-title">Agents <em>Hive.</em></h1>
        <p>A delivery architecture for turning one product goal into coordinated, verifiable work across specialist AI agents.</p>
        <div class="project-actions">
          <a class="button button-primary" href="https://github.com/ratarca" target="_blank" rel="noreferrer">Follow the work <Icon name="external" size={16} /></a>
          <span>Gateways · Sprint DAGs · Independent QA</span>
        </div>
      </div>
      <div class="agent-hive-cover agent-hive-loop-cover" data-reveal>
        <img src="/assets/img/project/agent_hive/graph-loop.png" alt="Pixel-art Media Factory workflow showing a user request moving through a coordinator, specialized workers, QA, integration, and delivery" />
        <span class="agent-hive-stamp">HIVE / 001 · WORKFLOW</span>
      </div>
    </div>
  </section>

  <section class="project-summary agent-hive-summary">
    <div class="brief-copy">
      <p class="eyebrow">The thesis</p>
      <p class="project-statement">We did not build a swarm of agents that simply talk to one another. We built a delivery system where specialization can scale without losing control, evidence, or accountability.</p>
    </div>
    <figure class="agent-hive-sprint-figure" data-reveal>
      <img src="/assets/img/project/agent_hive/sprint.png" alt="Pixel-art Hive Agents sprint workflow showing sprint definition, coordinator selection, gateway orchestration, and the plan, select, execute, review, and advance loop" />
      <figcaption>From opportunity mapping to a selected, evidence-gated sprint.</figcaption>
    </figure>
  </section>

  <section class="agent-hive-story" aria-labelledby="story-title">
    <div class="agent-hive-inner agent-hive-story-grid">
      <div class="project-section-heading">
        <p class="eyebrow">Why we built it</p>
        <h2 id="story-title">Agent capability was never the hardest problem. <em>Coordination was.</em></h2>
      </div>
      <div class="agent-hive-story-copy">
        <p>Media Factory moves through a complete product path: discover a market, analyze source material, generate original ideas and scripts, assemble scenes and assets, and render a validated video. Each stage needs a different kind of reasoning, but all of them must preserve the same product intent.</p>
        <p>A single agent can attempt the whole journey, yet long-running work quickly becomes fragile. Context grows noisy, responsibilities blur, retries repeat old mistakes, and a plausible answer can be mistaken for a delivered feature. Agent Hive is our answer to that operational gap.</p>
        <p>The coordinator translates intent into a <strong>design gateway</strong>: a versioned contract for the sprint. The gateway becomes a DAG of bounded tasks. Specialists receive only the context their task requires, produce reproducible evidence, and hand the candidate to an independent QA agent before integration.</p>
      </div>
    </div>
    <figure class="agent-hive-map" data-reveal>
      <img src="/assets/img/project/agent_hive/graph-loop.png" alt="Complete Media Factory Agent Hive workflow from stakeholder request through coordination, specialist implementation, independent QA, integration, delivery, and continuous learning" loading="lazy" />
      <figcaption>The operating system of the hive: goal → design gateway → specialist sprint DAG → independent QA → verified delivery.</figcaption>
    </figure>
  </section>

  <section class="agent-hive-foundations" aria-labelledby="foundations-title">
    <div class="agent-hive-inner">
      <div class="project-section-heading">
        <p class="eyebrow">Architecture</p>
        <h2 id="foundations-title">A control plane for autonomous work.</h2>
      </div>
      <div class="agent-hive-foundation-grid">
        {foundations.map((item, index) => <article><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="agent-hive-drawings" aria-labelledby="drawings-title">
    <div class="agent-hive-inner">
      <div class="project-section-heading">
        <p class="eyebrow">How it moves</p>
        <h2 id="drawings-title">Two loops keep the hive aligned.</h2>
        <p class="design-lede">The delivery graph moves work forward. The evidence loop decides whether it is ready to move at all.</p>
      </div>

      <div class="agent-hive-drawing-grid">
        <article class="agent-hive-drawing-panel">
          <header><span>Drawing 01</span><h3>Coordination DAG</h3></header>
          <div class="hive-dag" role="img" aria-label="A product goal enters the design gateway, the coordinator dispatches tasks to backend, frontend, and data specialists, and their candidates converge at independent QA before delivery">
            <div class="hive-dag-main">
              <div class="hive-node"><small>Input</small><strong>Product goal</strong></div>
              <i aria-hidden="true"></i>
              <div class="hive-node hive-node-gold"><small>Control plane</small><strong>Design gateway</strong></div>
              <i aria-hidden="true"></i>
              <div class="hive-node"><small>Owner</small><strong>Coordinator</strong></div>
            </div>
            <div class="hive-split" aria-hidden="true"><span></span><span></span><span></span></div>
            <div class="hive-worker-row">
              <div class="hive-node hive-worker hive-worker-blue"><small>Specialist</small><strong>Backend</strong></div>
              <div class="hive-node hive-worker hive-worker-purple"><small>Specialist</small><strong>Frontend</strong></div>
              <div class="hive-node hive-worker hive-worker-green"><small>Specialist</small><strong>Data</strong></div>
            </div>
            <div class="hive-merge" aria-hidden="true"><span></span><span></span><span></span></div>
            <div class="hive-dag-main hive-dag-final">
              <div class="hive-node hive-node-qa"><small>Independent gate</small><strong>QA + evidence</strong></div>
              <i aria-hidden="true"></i>
              <div class="hive-node hive-node-done"><small>Output</small><strong>Delivered impact</strong></div>
            </div>
          </div>
          <p class="agent-hive-drawing-caption">Dependencies decide the order. Independent write scopes decide what may run in parallel.</p>
        </article>

        <article class="agent-hive-drawing-panel">
          <header><span>Drawing 02</span><h3>Evidence &amp; repair loop</h3></header>
          <div class="hive-evidence-loop" role="img" aria-label="A specialist implements a bounded change, runs a narrow test, records evidence, and sends it to review; a pass proceeds to integration while a failure returns to the same scoped repair loop">
            <ol>
              <li><span>01</span><strong>Implement</strong><small>one bounded change</small></li>
              <li><span>02</span><strong>Test</strong><small>falsify the change</small></li>
              <li><span>03</span><strong>Record</strong><small>revision + evidence</small></li>
              <li><span>04</span><strong>Review</strong><small>consumer boundary</small></li>
            </ol>
            <div class="hive-review-outcomes">
              <div class="hive-outcome-pass"><span>Pass</span><strong>Integrate →</strong><small>final acceptance</small></div>
              <div class="hive-outcome-fail"><span>Fail</span><strong>↺ Repair</strong><small>same task · same scope</small></div>
            </div>
            <div class="hive-memory-strip"><span>Durable memory</span><strong>checkpoint · iteration record · test output · artifact hash</strong></div>
          </div>
          <p class="agent-hive-drawing-caption">Failure creates focused repair work; it never disappears inside a rewritten success story.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="agent-hive-system" aria-labelledby="system-title">
    <div class="agent-hive-inner">
      <div class="project-section-heading">
        <p class="eyebrow">Roles, not personas</p>
        <h2 id="system-title">Many specialists. One accountable system.</h2>
        <p class="design-lede">Roles are defined by ownership and acceptance—not by personality. The coordinator keeps the outcome whole while every specialist works inside an explicit scope.</p>
      </div>
      <div class="agent-hive-agent-grid">
        {agents.map((agent) => <article class="agent-hive-agent"><span>{agent.code}</span><h3>{agent.name}</h3><p>{agent.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="agent-hive-loop" aria-labelledby="loop-title">
    <div class="agent-hive-inner">
      <div class="project-section-heading">
        <p class="eyebrow">Gateway sprint</p>
        <h2 id="loop-title">From product intent to <em>verified impact.</em></h2>
        <p class="design-lede">The loop is a stateful delivery process. Every transition has an entry condition, an owner, and evidence that the next agent can inspect.</p>
      </div>
      <ol class="agent-hive-loop-grid">
        {loop.map((step, index) => <li><span>0{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}
      </ol>
    </div>
  </section>

  <section class="agent-hive-principles" aria-label="Agent Hive principles">
    <div class="agent-hive-inner agent-hive-principles-grid">
      <p class="eyebrow">What stays human</p>
      <p>Product direction, trade-offs, and the final call. The hive accelerates execution while keeping its reasoning, changes, and evidence visible enough for a person to challenge.</p>
      <a class="lab-cta-pill lab-cta-pill-dark" href="/contact"><span class="lab-cta-pulse" aria-hidden="true"></span><span class="lab-cta-copy"><strong>Bring a messy problem to the hive.</strong><span>Let’s turn it into a useful system.</span></span><span class="lab-cta-arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span></a>
    </div>
  </section>
</BaseLayout>
