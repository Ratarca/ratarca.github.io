---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
---

<BaseLayout title="Experience — Rafael Targino" description="Experience across data platforms, finance, risk, and software engineering." current="experience">
  <section class="inner-hero experience-hero" aria-labelledby="experience-title">
    <p class="eyebrow">02 — Experience</p>
    <h1 id="experience-title">Turning complex operations into systems that <em>work.</em></h1>
    <p>From market infrastructure and credit risk to modern data platforms, I build the foundations teams use to move with confidence.</p>
    <a class="text-link" href="/labs">See selected work <Icon name="arrow" size={17} /></a>
  </section>
  <section class="experience-page-section">
    <div class="experience-layout">
      <ExperienceTimeline />
      <aside class="experience-aside" data-reveal>
        <p class="eyebrow">The throughline</p>
        <p>I work at the point where business constraints, data, and reliable software meet.</p>
        <ul>
          <li><strong>8+</strong><span>years building technology</span></li>
          <li><strong>4</strong><span>teams across finance &amp; data</span></li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>
