---
import { capabilities } from '../data/site';
import SkillEngraving from './SkillEngraving.astro';
---

<section class="capability-section" id="capabilities" aria-labelledby="capability-title">
  <header class="capability-heading" data-reveal>
    <div>
      <p class="eyebrow">02 — Connected capability</p>
      <h2 id="capability-title">Skills become valuable when they work as a <em>system.</em></h2>
    </div>
    <p>Five disciplines connected through problem solving. Read the engraving or set it in motion to follow the connections between the tools I use every day.</p>
  </header>

  <div class="skill-atlas" data-skill-atlas>
    <header class="atlas-masthead">
      <div>
        <p class="atlas-edition">Field notes / Fig. 01</p>
        <h3>Atlas of capabilities</h3>
      </div>
      <div class="atlas-modes" role="group" aria-label="Engraving mode" data-atlas-controls hidden>
        <button type="button" data-atlas-mode="static" aria-pressed="true" aria-controls="atlas-plate">
          <svg viewBox="0 0 18 18" width="16" height="16" aria-hidden="true"><rect x="4" y="3" width="10" height="12" fill="none" stroke="currentColor"/><path d="M6 7h6M6 10h6M6 13h4" fill="none" stroke="currentColor"/></svg>
          Static engraving
        </button>
        <button type="button" data-atlas-mode="animated" aria-pressed="false" aria-controls="atlas-plate" aria-describedby="atlas-motion-note">
          <svg viewBox="0 0 18 18" width="16" height="16" aria-hidden="true"><path d="m5 3 10 6-10 6Z" fill="none" stroke="currentColor"/></svg>
          Animated engraving
        </button>
      </div>
    </header>

    <div class="atlas-spread">
      <figure class="atlas-plate" id="atlas-plate">
        <div class="atlas-plate-heading"><span>Systems · disciplines · connections</span><span aria-hidden="true">✳</span></div>
        <SkillEngraving />
        <figcaption>
          <strong>Problem solving</strong>
          <span>the thread through every discipline</span>
        </figcaption>
      </figure>

      <div class="atlas-key">
        <p class="atlas-key-heading">A reading key <span aria-hidden="true">↙</span></p>
        <ol class="atlas-disciplines">
          {capabilities.map((item) => (
            <li>
              <button type="button" data-atlas-discipline={item.id} aria-pressed="false" aria-controls="atlas-plate" disabled>
                <span class="atlas-number" aria-hidden="true">{item.number}</span>
                <span class="atlas-entry">
                  <span class="atlas-name">{item.name}</span>
                  <span class="atlas-tools">{item.tools}</span>
                </span>
                <span class="atlas-entry-mark" aria-hidden="true">↗</span>
              </button>
            </li>
          ))}
        </ol>
        <p class="atlas-instruction" data-atlas-controls hidden>Select a discipline to trace its branch. Select it again to see the whole atlas.</p>
      </div>
    </div>

    <footer class="atlas-colophon">
      <span class="atlas-status" role="status" data-atlas-status>Static engraving · all five disciplines</span>
      <span>Five disciplines. One way of working.</span>
    </footer>
    <p class="atlas-motion-note" id="atlas-motion-note" hidden>Motion is reduced in your device settings. Explore every branch in the static engraving.</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-skill-atlas]').forEach((atlas) => {
    const modes = atlas.querySelectorAll<HTMLButtonElement>('[data-atlas-mode]');
    const disciplines = atlas.querySelectorAll<HTMLButtonElement>('[data-atlas-discipline]');
    const branches = atlas.querySelectorAll<SVGGElement>('[data-atlas-branch]');
    const status = atlas.querySelector<HTMLElement>('[data-atlas-status]');
    const motionNote = atlas.querySelector<HTMLElement>('.atlas-motion-note');
    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
    let animated = false;
    let selected: string | null = null;
    let inView = false;

    const render = () => {
      atlas.classList.toggle('is-animated', animated);
      atlas.classList.toggle('has-selection', selected !== null);
      modes.forEach((button) => {
        const isAnimated = button.dataset.atlasMode === 'animated';
        button.setAttribute('aria-pressed', String(isAnimated === animated));
        button.disabled = isAnimated && motionPreference.matches;
      });
      disciplines.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.atlasDiscipline === selected)));
      branches.forEach((branch) => branch.classList.toggle('is-selected', branch.dataset.atlasBranch === selected));
      const name = Array.from(disciplines).find((button) => button.dataset.atlasDiscipline === selected)?.querySelector('.atlas-name')?.textContent;
      if (status) status.textContent = `${animated ? 'Animated' : 'Static'} engraving · ${name ? `${name} selected` : 'all five disciplines'}`;
      if (motionNote) motionNote.hidden = !motionPreference.matches;
    };

    atlas.querySelectorAll<HTMLElement>('[data-atlas-controls]').forEach((element) => { element.hidden = false; });
    modes.forEach((button) => button.addEventListener('click', () => {
      animated = button.dataset.atlasMode === 'animated' && !motionPreference.matches;
      render();
    }));
    disciplines.forEach((button) => {
      button.disabled = false;
      button.addEventListener('click', () => {
        const id = button.dataset.atlasDiscipline ?? null;
        selected = selected === id ? null : id;
        render();
      });
    });
    motionPreference.addEventListener('change', () => {
      if (motionPreference.matches) animated = false;
      render();
    });

    // CSS animation runs only on request, while the plate is on screen.
    const updateVisibility = () => atlas.classList.toggle('is-in-view', inView && !document.hidden);
    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      updateVisibility();
    });
    observer.observe(atlas.querySelector('.atlas-plate') ?? atlas);
    document.addEventListener('visibilitychange', updateVisibility);
    render();
  });
</script>
