---
import WorkflowEngraving from './WorkflowEngraving.astro';
import { workflowTasks } from '../data/site';
---

<div class="dag-scene" id="problem-to-value" data-dag-scene>
  <header class="dag-toolbar">
    <div>
      <span class="dag-dot" aria-hidden="true"></span>
      <strong id="workflow-title">problem_to_value</strong>
      <span class="dag-schedule" data-workflow-schedule>still</span>
    </div>
    <div class="dag-controls" role="group" aria-label="Workflow engraving mode" data-workflow-controls hidden>
      <button type="button" data-workflow-mode="static" aria-pressed="true" aria-controls="workflow-plate">Static</button>
      <button type="button" data-workflow-mode="animated" aria-pressed="false" aria-controls="workflow-plate" aria-describedby="workflow-motion-note">Animated</button>
    </div>
  </header>

  <figure class="dag-plate" id="workflow-plate" aria-labelledby="workflow-title">
    <div class="dag-art">
      <WorkflowEngraving />
      <WorkflowEngraving compact />
    </div>
    <figcaption class="dag-description">
      <p>Problem leads to Understand, which connects to a compact puppet theater labeled Agents AI, with a curved marquee and curtains tied to either side. Inside it, three glove puppets form an upward-pointing triangle: Design carries a set square at the top, Build holds a hammer and block at the lower right, and Validate inspects with a magnifier at the lower left. Three straight edges form the loop: Design to Build, Build to Validate, and Validate to Design. The theater connects to Solution, then Value.</p>
      <ol>{workflowTasks.map((task) => <li>{task.title}</li>)}</ol>
    </figcaption>
  </figure>

  <footer class="dag-footer">
    <span data-task-count>7 / 7 tasks</span>
    <span><i class="dag-success-dot" aria-hidden="true"></i> success only</span>
    <span>0 failures</span>
    <span class="dag-run-state is-success" data-run-state>SUCCESS</span>
  </footer>
  <p class="dag-motion-note" id="workflow-motion-note" hidden>Reduced motion is enabled on your device. Choose Animated to play this workflow, or keep the static view.</p>
</div>

<script>
  import { workflowDependencies, workflowSequence, workflowTasks } from '../data/site';

  document.querySelectorAll<HTMLElement>('[data-dag-scene]').forEach((container) => {
    const nodes = container.querySelectorAll<SVGGElement>('[data-workflow-node]');
    const links = container.querySelectorAll<SVGGElement>('[data-workflow-edge]');
    const modes = container.querySelectorAll<HTMLButtonElement>('[data-workflow-mode]');
    const stateLabel = container.querySelector<HTMLElement>('[data-run-state]');
    const countLabel = container.querySelector<HTMLElement>('[data-task-count]');
    const schedule = container.querySelector<HTMLElement>('[data-workflow-schedule]');
    const motionNote = container.querySelector<HTMLElement>('.dag-motion-note');
    const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
    const stepDuration = 1200;
    let animated = !preference.matches;
    let step = animated ? 0 : workflowSequence.length;
    let inView = false;
    let timeout: number | undefined;
    let startedAt = 0;
    let remaining = stepDuration;

    const render = () => {
      const completed = step >= workflowSequence.length;
      const currentTask = completed ? null : workflowSequence[step];
      const visitedTasks = new Set(workflowSequence.slice(0, step));
      if (currentTask !== null) visitedTasks.delete(currentTask);
      const visitedEdges = new Set(workflowSequence.slice(1, step + 1).map((to, index) =>
        workflowDependencies.findIndex(([fromTask, toTask]) => fromTask === workflowSequence[index] && toTask === to)
      ));
      const activeEdge = step > 0 && !completed
        ? workflowDependencies.findIndex(([from, to]) => from === workflowSequence[step - 1] && to === currentTask)
        : -1;
      container.classList.toggle('is-animated', animated);
      nodes.forEach((node) => {
        const taskIndex = Number(node.dataset.workflowNode);
        node.dataset.state = taskIndex === currentTask ? 'running' : completed || visitedTasks.has(taskIndex) ? 'success' : 'queued';
      });
      links.forEach((link) => {
        const edgeIndex = Number(link.dataset.workflowEdge);
        link.dataset.state = edgeIndex === activeEdge ? 'running' : completed || visitedEdges.has(edgeIndex) ? 'success' : 'queued';
      });
      if (stateLabel) {
        stateLabel.textContent = completed ? 'SUCCESS' : 'RUNNING';
        stateLabel.classList.toggle('is-success', completed);
      }
      if (countLabel) countLabel.textContent = `${completed ? workflowTasks.length : visitedTasks.size} / ${workflowTasks.length} tasks`;
      if (schedule) schedule.textContent = animated ? 'continuous' : 'still';
      if (motionNote) {
        motionNote.hidden = !preference.matches;
        motionNote.textContent = animated
          ? 'Playing by your choice. Choose Static to stop the animation.'
          : 'Reduced motion is enabled on your device. Choose Animated to play this workflow, or keep the static view.';
      }
      modes.forEach((button) => {
        const isAnimated = button.dataset.workflowMode === 'animated';
        button.setAttribute('aria-pressed', String(isAnimated === animated));
      });
    };

    const pause = () => {
      if (timeout !== undefined) {
        window.clearTimeout(timeout);
        remaining = Math.max(0, remaining - (performance.now() - startedAt));
        timeout = undefined;
      }
      container.classList.remove('is-running');
    };

    const resume = () => {
      if (!animated || !inView || document.hidden || timeout !== undefined) return;
      container.classList.add('is-running');
      startedAt = performance.now();
      timeout = window.setTimeout(() => {
        timeout = undefined;
        step = (step + 1) % (workflowSequence.length + 1);
        remaining = step === workflowSequence.length ? 2200 : stepDuration;
        render();
        resume();
      }, remaining);
    };

    const updatePlayback = () => {
      if (animated && inView && !document.hidden) resume();
      else pause();
    };

    const setMode = (animate: boolean) => {
      pause();
      // Reduced motion sets the initial mode; the reader can explicitly opt in.
      animated = animate;
      step = animated ? 0 : workflowSequence.length;
      remaining = stepDuration;
      render();
      updatePlayback();
    };

    container.querySelectorAll<HTMLElement>('[data-workflow-controls]').forEach((element) => { element.hidden = false; });
    modes.forEach((button) => button.addEventListener('click', () => setMode(button.dataset.workflowMode === 'animated')));
    preference.addEventListener('change', () => {
      if (preference.matches) setMode(false);
      else render();
    });
    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      updatePlayback();
    });
    observer.observe(container.querySelector('.dag-art') ?? container);
    document.addEventListener('visibilitychange', updatePlayback);
    window.addEventListener('pagehide', () => { pause(); observer.disconnect(); }, { once: true });
    render();
  });
</script>
